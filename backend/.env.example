# Copy to .env (or set these in your hosting dashboard). All values are optional for local development.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty for SQLite. PostgreSQL example: postgres://user:password@host:5432/dbname
DATABASE_URL=
# Comma separated, e.g. https://your-frontend.vercel.app  (when empty and DEBUG=True every origin is allowed)
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
